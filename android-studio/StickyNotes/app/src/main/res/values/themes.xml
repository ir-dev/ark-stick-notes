<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <!-- AppCompat, not MaterialComponents (see app/build.gradle). colorPrimaryDark and colorAccent
         are the AppCompat names for Material's colorPrimaryVariant and colorSecondary. AppCompat
         also takes the status bar colour from colorPrimaryDark; edge-to-edge overrides it anyway. -->
    <style name="Theme.StickyNotes" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.StickyNotes.Fullscreen" parent="Theme.StickyNotes">
        <item name="android:actionBarStyle">@style/Widget.Theme.StickyNotes.ActionBar.Fullscreen
        </item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
    </style>

    <style name="ThemeOverlay.StickyNotes.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_600</item>
        <item name="fullscreenTextColor">@color/light_blue_A200</item>
    </style>
</resources>